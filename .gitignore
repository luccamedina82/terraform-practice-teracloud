# Terraform local state and backups (real state lives in S3)
*.tfstate
*.tfstate.*

# Local .terraform directories (provider binaries, downloaded modules)
**/.terraform/*

# Crash logs
crash.log
crash.*.log

# Any *.tfvars files that might hold secrets (none tracked currently, but just in case)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
